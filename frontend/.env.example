# Browser-accessible FastAPI base URL. No credentials or API keys.
# Copy to .env.local and restart Vite. This URL is shared by HTTP adapters.
# VITE_API_URL is a legacy alias; VITE_API_BASE_URL takes precedence.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Explicit startup patient source: mock or backend. Also switchable in the header.
VITE_PATIENT_DATA_MODE=mock
